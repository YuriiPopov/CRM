DATABASE_URL="postgresql://b4u:b4u_dev_password@localhost:5432/b4u_crm?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Часовой пояс салона (IANA). Время записей хранится как время салона с меткой UTC, и
# проверки «уже наступило / в прошлом» сравнивают его с текущим временем в этом поясе.
# Неизвестное значение — backend не стартует. По умолчанию Europe/Warsaw.
SALON_TIMEZONE="Europe/Warsaw"

# Используются только скриптом prisma/seed.ts для создания первого admin-пользователя
SEED_SALON_NAME="B4U Demo Salon"
SEED_ADMIN_EMAIL="admin@b4u.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Клиентское мобильное приложение (/client/*)
# Салон, к которому привязано приложение; без него берётся первый салон в БД (dev/демо)
# CLIENT_APP_SALON_ID=""
CLIENT_JWT_EXPIRES_IN="30d"
# Только для локальной разработки без SMS-провайдера: код входа возвращается в ответе API.
# НИКОГДА не включать в production — это обход проверки телефона.
CLIENT_OTP_DEV_MODE=false
