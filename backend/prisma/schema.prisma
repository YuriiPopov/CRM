// Prisma schema — B4U CRM
// Соответствует ER-модели из BEAUTY4YOU_Architecture_CRM.md
// Каждая ключевая сущность несёт salonId — задел под мультифилиальность (см. архитектуру, п.3)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MASTER
}

enum BookingStatus {
  CREATED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingSource {
  ADMIN
  ONLINE
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_RESCHEDULED
  BOOKING_CANCELLATION
}

model Salon {
  id        String   @id @default(uuid())
  name      String
  address   String?
  timezone  String   @default("Europe/Warsaw")
  createdAt DateTime @default(now())

  clients                      Client[]
  masters                      Master[]
  services                     Service[]
  serviceCategories            ServiceCategory[]
  bookings                     Booking[]
  materials                    Material[]
  staffUsers                   User[]
  masterBlocks                 MasterBlock[]
  masterSchedules              MasterSchedule[]
  dashboardWidgetRoleDefaults  DashboardWidgetRoleDefault[]
  dashboardWidgetUserOverrides DashboardWidgetUserOverride[]

  @@map("salons")
}

// Пользователь системы (для Auth) — отдельно от Master,
// так как не у каждого мастера обязательно есть логин на старте.
model User {
  id           String   @id @default(uuid())
  salonId      String
  salon        Salon    @relation(fields: [salonId], references: [id])
  email        String   @unique
  passwordHash String
  role         Role
  masterId     String?  @unique
  master       Master?  @relation(fields: [masterId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  createdMasterBlocks      MasterBlock[]                 @relation("MasterBlockCreatedBy")
  dashboardWidgetOverrides DashboardWidgetUserOverride[]

  @@map("users")
}

model Client {
  id                 String    @id @default(uuid())
  salonId            String
  salon              Salon     @relation(fields: [salonId], references: [id])
  name               String
  phone              String
  email              String?
  notes              String?
  tags               String[]
  consentGivenAt     DateTime?
  consentWithdrawnAt DateTime?
  createdAt          DateTime  @default(now())

  bookings         Booking[]
  deletionRequests DataDeletionRequest[]

  @@index([salonId])
  @@map("clients")
}

model Master {
  id        String   @id @default(uuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  // Фото мастера как base64 data URL (item41) — MVP-хранение в БД без внешнего файлового
  // хранилища; клиент ресайзит/сжимает до отправки, сервер дополнительно проверяет формат
  // (JPEG/PNG/WebP) и итоговый размер после декодирования (см. StaffService.assertPhotoSize).
  photo     String?

  user            User?
  services        MasterService[]
  specializations MasterSpecialization[]
  bookings        Booking[]
  blocks          MasterBlock[]
  schedules       MasterSchedule[]

  @@index([salonId])
  @@map("masters")
}

model ServiceCategory {
  id        String   @id @default(uuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  services        Service[]
  specializations MasterSpecialization[]

  @@index([salonId])
  @@map("service_categories")
}

model Service {
  id          String          @id @default(uuid())
  salonId     String
  salon       Salon           @relation(fields: [salonId], references: [id])
  name        String
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  durationMin Int
  price       Decimal         @db.Decimal(10, 2)
  createdAt   DateTime        @default(now())

  masters   MasterService[]
  materials ServiceMaterial[]
  bookings  Booking[]

  @@index([salonId])
  @@index([categoryId])
  @@map("services")
}

model MasterService {
  masterId  String
  master    Master  @relation(fields: [masterId], references: [id])
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([masterId, serviceId])
  @@map("master_services")
}

model MasterSpecialization {
  masterId   String
  master     Master          @relation(fields: [masterId], references: [id])
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id])

  @@id([masterId, categoryId])
  @@map("master_specializations")
}

model Booking {
  id                String        @id @default(uuid())
  salonId           String
  salon             Salon         @relation(fields: [salonId], references: [id])
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id])
  masterId          String
  master            Master        @relation(fields: [masterId], references: [id])
  serviceId         String
  service           Service       @relation(fields: [serviceId], references: [id])
  startTime         DateTime
  endTime           DateTime
  status            BookingStatus @default(CREATED)
  source            BookingSource @default(ADMIN)
  createdAt         DateTime      @default(now())
  rescheduledAt     DateTime?
  // Исходное время записи ДО первого переноса (Backlog item39) — заполняется один раз, при
  // первом reschedule(), текущими на тот момент startTime/endTime; последующие переносы его не
  // трогают (в отличие от rescheduledAt, которое обновляется на каждый перенос — см. item26).
  // null, если записи ещё не переносили.
  originalStartTime DateTime?
  originalEndTime   DateTime?

  payment       Payment?
  notifications Notification[]

  @@index([salonId])
  @@index([masterId, startTime])
  @@map("bookings")
}

// Резервирование/блокировка времени мастера (Backlog п.9) — выходной, отпуск, перерыв.
// Не привязана к конкретной записи клиента; учитывается наравне с Booking в overlap-проверке
// (см. booking-overlap.util.ts) — мастер недоступен для новой записи, пока действует блокировка.
model MasterBlock {
  id        String   @id @default(uuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  masterId  String
  master    Master   @relation(fields: [masterId], references: [id])
  startTime DateTime
  endTime   DateTime
  reason    String?
  createdAt DateTime @default(now())

  // Кто поставил блокировку (ADMIN за мастера или сам MASTER) — Backlog: "кем создано" в
  // карточке блокировки. Nullable — записи, созданные до этой миграции, его не имеют
  // (см. фронтовый fallback без слова "не найден" для этого случая).
  createdById String?
  createdBy   User?   @relation("MasterBlockCreatedBy", fields: [createdById], references: [id])

  @@index([salonId])
  @@index([masterId, startTime])
  @@map("master_blocks")
}

// Регулярный график работы мастера (Backlog item28, подзадача №33) — администратор помесячно
// отмечает рабочие/нерабочие дни. Явная запись на КАЖДЫЙ день месяца (isWorking true/false), а не
// только на рабочие: так "день ещё не размечен админом" (записи нет вовсе) отличимо от "день
// размечен как выходной" — это важно для валидации переноса/бронирования в подзадаче №35, где
// отсутствие графика не должно трактоваться как запрет. Часы работы — свои у каждого мастера/дня,
// это отдельное окно от TIMELINE_END_HOUR/SALON_CLOSE_HOUR_UTC (см. item23) — то фиксированное окно
// отображения на всех, это — per-мастер расписание. MasterBlock не трогается, это отдельный
// механизм точечных исключений (отпуск/перерыв) поверх любого графика.
model MasterSchedule {
  id        String   @id @default(uuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  masterId  String
  master    Master   @relation(fields: [masterId], references: [id])
  date      DateTime @db.Date
  isWorking Boolean
  // Рабочие часы дня в формате "HH:mm"; null, если день нерабочий (см. MasterSchedulesService.upsertMonth —
  // при isWorking=false часы всегда сбрасываются в null, чтобы не копить неактуальные значения).
  startTime String?
  endTime   String?
  createdAt DateTime @default(now())

  @@unique([masterId, date])
  @@index([salonId])
  @@map("master_schedules")
}

model Payment {
  id        String    @id @default(uuid())
  bookingId String    @unique
  booking   Booking   @relation(fields: [bookingId], references: [id])
  amount    Decimal   @db.Decimal(10, 2)
  discount  Decimal   @default(0) @db.Decimal(10, 2)
  method    String
  status    String
  paidAt    DateTime?

  @@map("payments")
}

model Material {
  id            String  @id @default(uuid())
  salonId       String
  salon         Salon   @relation(fields: [salonId], references: [id])
  name          String
  unit          String
  stockQuantity Decimal @default(0) @db.Decimal(10, 2)

  services ServiceMaterial[]

  @@index([salonId])
  @@map("materials")
}

model ServiceMaterial {
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id])
  materialId   String
  material     Material @relation(fields: [materialId], references: [id])
  quantityUsed Decimal  @db.Decimal(10, 2)

  @@id([serviceId, materialId])
  @@map("service_materials")
}

model Notification {
  id        String              @id @default(uuid())
  bookingId String
  booking   Booking             @relation(fields: [bookingId], references: [id])
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([bookingId])
  @@map("notifications")
}

// Видимость виджетов дашборда (Backlog: настройка видимости) — два уровня приоритета:
// ролевой дефолт (per widget key, per role) и пользовательское переопределение (per widget
// key, per userId), которое всегда выигрывает у дефолта. widgetKey — String, а не Prisma enum:
// список виджетов задаётся константой в коде (DASHBOARD_WIDGET_KEYS), чтобы добавление нового
// виджета не требовало миграции. Отсутствие строки в обеих моделях = дефолт visible=true
// (см. DashboardSettingsService.getEffectiveWidgets) — не нужно засеивать все комбинации.
model DashboardWidgetRoleDefault {
  id        String   @id @default(uuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  role      Role
  widgetKey String
  visible   Boolean
  updatedAt DateTime @updatedAt

  @@unique([salonId, role, widgetKey])
  @@index([salonId])
  @@map("dashboard_widget_role_defaults")
}

model DashboardWidgetUserOverride {
  id        String   @id @default(uuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  widgetKey String
  visible   Boolean
  updatedAt DateTime @updatedAt

  @@unique([userId, widgetKey])
  @@index([salonId])
  @@map("dashboard_widget_user_overrides")
}

// GDPR — право на удаление (см. ТЗ, раздел "Нефункциональные требования")
model DataDeletionRequest {
  id          String    @id @default(uuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  requestedAt DateTime  @default(now())
  status      String    @default("pending")
  processedAt DateTime?

  @@map("data_deletion_requests")
}
