// Prisma schema — B4U CRM
// Соответствует ER-модели из BEAUTY4YOU_Architecture_CRM.md
// Каждая ключевая сущность несёт salonId — задел под мультифилиальность (см. архитектуру, п.3)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MASTER
}

enum BookingStatus {
  CREATED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingSource {
  ADMIN
  ONLINE
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_RESCHEDULED
  BOOKING_CANCELLATION
}

enum ServiceCategory {
  MANICURE_PEDICURE
  SPA
  MASSAGE
}

model Salon {
  id        String   @id @default(uuid())
  name      String
  address   String?
  timezone  String   @default("Europe/Warsaw")
  createdAt DateTime @default(now())

  clients      Client[]
  masters      Master[]
  services     Service[]
  bookings     Booking[]
  materials    Material[]
  staffUsers   User[]
  masterBlocks MasterBlock[]

  @@map("salons")
}

// Пользователь системы (для Auth) — отдельно от Master,
// так как не у каждого мастера обязательно есть логин на старте.
model User {
  id           String   @id @default(uuid())
  salonId      String
  salon        Salon    @relation(fields: [salonId], references: [id])
  email        String   @unique
  passwordHash String
  role         Role
  masterId     String?  @unique
  master       Master?  @relation(fields: [masterId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  createdMasterBlocks MasterBlock[] @relation("MasterBlockCreatedBy")

  @@map("users")
}

model Client {
  id                 String    @id @default(uuid())
  salonId            String
  salon              Salon     @relation(fields: [salonId], references: [id])
  name               String
  phone              String
  email              String?
  notes              String?
  tags               String[]
  consentGivenAt     DateTime?
  consentWithdrawnAt DateTime?
  createdAt          DateTime  @default(now())

  bookings          Booking[]
  deletionRequests  DataDeletionRequest[]

  @@index([salonId])
  @@map("clients")
}

model Master {
  id             String   @id @default(uuid())
  salonId        String
  salon          Salon    @relation(fields: [salonId], references: [id])
  name           String
  specialization ServiceCategory
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  user            User?
  services        MasterService[]
  bookings        Booking[]
  blocks          MasterBlock[]

  @@index([salonId])
  @@map("masters")
}

model Service {
  id          String          @id @default(uuid())
  salonId     String
  salon       Salon           @relation(fields: [salonId], references: [id])
  name        String
  category    ServiceCategory
  durationMin Int
  price       Decimal         @db.Decimal(10, 2)
  createdAt   DateTime        @default(now())

  masters   MasterService[]
  materials ServiceMaterial[]
  bookings  Booking[]

  @@index([salonId])
  @@map("services")
}

model MasterService {
  masterId  String
  master    Master  @relation(fields: [masterId], references: [id])
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([masterId, serviceId])
  @@map("master_services")
}

model Booking {
  id        String        @id @default(uuid())
  salonId   String
  salon     Salon         @relation(fields: [salonId], references: [id])
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])
  masterId  String
  master    Master        @relation(fields: [masterId], references: [id])
  serviceId String
  service   Service       @relation(fields: [serviceId], references: [id])
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(CREATED)
  source    BookingSource @default(ADMIN)
  createdAt DateTime      @default(now())

  payment       Payment?
  notifications Notification[]

  @@index([salonId])
  @@index([masterId, startTime])
  @@map("bookings")
}

// Резервирование/блокировка времени мастера (Backlog п.9) — выходной, отпуск, перерыв.
// Не привязана к конкретной записи клиента; учитывается наравне с Booking в overlap-проверке
// (см. booking-overlap.util.ts) — мастер недоступен для новой записи, пока действует блокировка.
model MasterBlock {
  id        String   @id @default(uuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  masterId  String
  master    Master   @relation(fields: [masterId], references: [id])
  startTime DateTime
  endTime   DateTime
  reason    String?
  createdAt DateTime @default(now())

  // Кто поставил блокировку (ADMIN за мастера или сам MASTER) — Backlog: "кем создано" в
  // карточке блокировки. Nullable — записи, созданные до этой миграции, его не имеют
  // (см. фронтовый fallback без слова "не найден" для этого случая).
  createdById String?
  createdBy   User?   @relation("MasterBlockCreatedBy", fields: [createdById], references: [id])

  @@index([salonId])
  @@index([masterId, startTime])
  @@map("master_blocks")
}

model Payment {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  amount    Decimal  @db.Decimal(10, 2)
  discount  Decimal  @default(0) @db.Decimal(10, 2)
  method    String
  status    String
  paidAt    DateTime?

  @@map("payments")
}

model Material {
  id            String   @id @default(uuid())
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id])
  name          String
  unit          String
  stockQuantity Decimal  @default(0) @db.Decimal(10, 2)

  services ServiceMaterial[]

  @@index([salonId])
  @@map("materials")
}

model ServiceMaterial {
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id])
  materialId   String
  material     Material @relation(fields: [materialId], references: [id])
  quantityUsed Decimal  @db.Decimal(10, 2)

  @@id([serviceId, materialId])
  @@map("service_materials")
}

model Notification {
  id        String              @id @default(uuid())
  bookingId String
  booking   Booking             @relation(fields: [bookingId], references: [id])
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([bookingId])
  @@map("notifications")
}

// GDPR — право на удаление (см. ТЗ, раздел "Нефункциональные требования")
model DataDeletionRequest {
  id          String    @id @default(uuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  requestedAt DateTime  @default(now())
  status      String    @default("pending")
  processedAt DateTime?

  @@map("data_deletion_requests")
}
