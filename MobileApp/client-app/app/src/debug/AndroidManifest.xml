<?xml version="1.0" encoding="utf-8"?>
<!-- Разрешаем cleartext-трафик только в debug — устройство ходит на http://127.0.0.1:3000 через adb reverse (backend
     на хосте, без TLS в dev-окружении). В release это не подмешивается. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
